rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function esPublica(coleccion) {
      return coleccion in ['sitio', 'horarios', 'fechas', 'lideres',
                           'galeria', 'publicaciones', 'biblioteca'];
    }

    // Contenido del sitio: lectura pública, escritura solo encargados
    match /{coleccion}/{documento} {
      allow read: if esPublica(coleccion);
      allow write: if esPublica(coleccion) && esAdmin();
    }

    // Lista de encargados: cada uno solo ve su propio registro
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
